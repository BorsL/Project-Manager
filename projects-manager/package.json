{
  "name": "projects-manager",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "0.2.0-canary-20260121-a63c0dd",
    "convex": "^1.39.1",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.4",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@biomejs/biome": "^2.4.15",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "56.0.12",
    "concurrently": "^9.2.1",
    "expo-doctor": "^1.19.8",
    "lefthook": "^2.1.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "concurrently -n convex,expo -c cyan,green \"pnpm dev:backend\" \"pnpm dev:app\"",
    "dev:backend": "convex dev",
    "dev:app": "expo start",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "start": "expo start",
    "android": "pnpm dev:android",
    "ios": "pnpm dev:ios",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "verify": "pnpm check && pnpm typecheck && pnpm doctor",
    "lint": "pnpm check",
    "eas:init": "pnpm dlx eas-cli init",
    "eas:env:preview": "pnpm dlx eas-cli env:create --environment preview --visibility plaintext --name EXPO_PUBLIC_CONVEX_URL",
    "build:preview": "pnpm dlx eas-cli build --profile preview --platform all",
    "build:preview:android": "pnpm dlx eas-cli build --profile preview --platform android",
    "build:preview:ios": "pnpm dlx eas-cli build --profile preview --platform ios"
  },
  "private": true
}
